@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Kafelino.Models.WeightViewModel>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-120">
    <h1>Разфасовки</h1>

    @if (this.User.IsInRole("Admin"))
    {
        <p>
            <a class="btn beige-button" asp-action="Create">Добави нова нотка</a>
        </p>
    }
    <table class="table">
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Value) @Html.DisplayNameFor(model => model.Unit)
            </th>
            <th></th>
        </tr>   
        </thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Value) @Html.DisplayFor(model => item.Unit)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.WeightId">Редактирай</a> |
                    <a asp-action="Delete" asp-route-id="@item.WeightId">Изтрий</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
