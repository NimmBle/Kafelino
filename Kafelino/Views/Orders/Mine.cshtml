@model List<Kafelino.Models.Orders.OrderDetailsOutputModel>

<section class="page-header mt-200">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="content">
                    <h1 class="page-name">Моите поръчки</h1>
                </div>
            </div>
        </div>
    </div>
</section>
<section class="user-dashboard page-wrapper">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <div class="dashboard-wrapper user-dashboard">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                            <tr>
                                <th>#</th>
                                <th>Име</th>
                                <th>Тел. номер</th>
                                <th>Адрес</th>
                                <th>Продукти</th>
                                <th>Дата на поръчване</th>
                                <th>Дата на доставка</th>
                                <th>Общо</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td>@order.Id</td>
                                    <td>@order.User?.Name</td>
                                    <td>@order.PhoneNumber</td>
                                    <td>@order.Address</td>
                                    <td>
                                        @foreach (var product in order.Products)
                                        {
                                            <a asp-controller="Products" asp-action="Details" asp-route-productId="@product.ProductId">
                                                <p>@product.Name x @product.Quantity</p>
                                            </a>
                                            <br/>
                                        }
                                    </td>
                                    <td>@order.CreatedOnDate</td>
                                    <td>@order.DeliveryDate</td>
                                    <td>@order.TotalSum лв.</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>