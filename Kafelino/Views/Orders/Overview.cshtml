@model Kafelino.Models.Orders.CreateOrderInputModel

<section class="page-header mt-160">
	<div class="container">
		<div class="row">
			<div class="col-md-12">
				<div class="content">
                    <h1 class="page-name">Поръчка</h1>
                    <hr class=" mb-80">
				</div>
			</div>
		</div>
	</div>
</section>
<div class="page-wrapper mb-120">
    <div class="checkout shopping">
        <div class="container">
            <div class="row">
                <div class="col-md-8">
                    <div class="block billing-details">
                        <h4 class="widget-title">Информация за доставка</h4>
                        <form class="checkout-form" asp-action="Create" method="post">
                            <input type="hidden" asp-for="TotalPrice">

                            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                            <div class="form-group w-50">
                                <label>Телефонен номер</label>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="">
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                            <br>
                            <div class="form-group w-50 mb-40">
                                <label>Адрес</label>
                                <input type="text" class="form-control" asp-for="Address" placeholder="">
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>
                            <br>
                            <div id="cf-submit">
                                <button type="submit" class="btn beige-button">
                                    Поръчай
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="product-checkout-details">
                        <div class="block">
                            <h4 class="widget-title">Продукти:</h4>
                            <hr>
                            @foreach (var product in Model.Products)
                            {
                                <div class="media product-card" style="display: flex; gap: 20px">
                                    <img style="height: 200px" class="media-object" src="~/Images/products/@product.ImageUrl" alt="Снимка на продукта"/>

                                    <div class="media-body pt-40">
                                        <h4 class="media-heading">@product.Name - @product.Weight.Value@product.Weight.Unit.</h4>
                                        <p class="price">@product.Quantity x @product.Price лв.</p>
                                    </div>
                                </div>
                                <hr/>
                            }
                            
                            <div class="summary-total ">
                                <span>Общо</span>
                                <span>@Model.TotalPrice лв.</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}