@using Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<Kafelino.Models.Products.ProductDetailsViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


@if (@Model.Count() > 0)
{
    <table class="table container">
        <h1 class="mt-160" style="text-align: center">Количка</h1>
        <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ImageUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Price)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Brand)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TasteNotes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantity)
            </th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    <img style="height: 140px" src="~/Images/products/@item.ImageUrl" alt="">
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Price)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Brand)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Weight.Value)
                    @Html.DisplayFor(modelItem => item.Weight.Unit)
                </td>
                <td>
                    @String.Join(", ", @item.TasteNotes.Select(ts => ts.Name))
                </td>
                <td>
                    <div class="quantity-controls">
                        <a class="custom-quantity-btn custom-quantity-decrease" asp-action="RemoveQuantity" asp-route-id="@item.ProductId">−</a>
                        <span class="custom-quantity-input">@Html.DisplayFor(modelItem => item.Quantity)</span>
                        <a class="custom-quantity-btn custom-quantity-increase" asp-action="AddQuantity" asp-route-id="@item.ProductId">+</a>
                    </div>
                    @* <a class="btn btn-danger" asp-action="RemoveQuantity" asp-route-id="@item.ProductId">-</a> *@
                    @* @Html.DisplayFor(modelItem => item.Quantity)" *@
                    @* <a class="btn btn-primary" asp-action="AddQuantity" asp-route-id="@item.ProductId">+</a> *@
                </td>
                <td>
                    <a class="btn btn-danger" asp-action="RemoveFromCart" asp-route-id="@item.ProductId">X</a>
                </td>
            </tr>
        }
        </tbody>
    </table>

<div class="row justify-content-center mb-40">
    <a class="btn beige-button" asp-controller="Orders" asp-action="Overview">Поръчай</a>
</div> 
}
@if (Model.Count() == 0)
{
    <h2 class="mt-200 mb-160 text-center">Няма продукти в количката</h2>
}
