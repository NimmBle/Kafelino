@using Microsoft.AspNetCore.Mvc.TagHelpers
@model Kafelino.Models.Products.ProductListingViewModel

@{
    ViewData["Title"] = "All";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="main-wrapper" class="section">
    <div class="product-section section pt-120 pb-120">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 col-md-6 col-12 mb-60">
                    <form method="get" asp-action="Filter" asp-controller="Products">
                        @if (this.User.IsInRole("Admin"))
                        {
                            <a class="btn btn-filter grey-button mb-8 w-100 mb-30" asp-controller="Products" asp-action="Create">Добави нов</a>
                        }
                        <h2>Филтрирай по: </h2>
                        <h4 class="mt-30 mb-10">Опаковка:</h4>
                        <div class="form-group">
                            @foreach (var weight in Model.Filters.Weights)
                            {
                                var isChecked = weight.Value == Model.Filters.Weight ? "checked" : "";

                                <input type="radio" id="@weight" name="weight" value="@weight.Value" @isChecked/>
                                <label class="input-filter mb-15" for="@weight">@weight.Value@weight.Unit</label>
                                <br/>
                            }
                        </div>
                        <hr>
                        <h4 class="mb-10">Вкусови нотки:</h4>
                        <div class="form-group">
                            @foreach (var taste in Model.Filters.TasteNotes)
                            {
                                var isChecked = taste.Name == Model.Filters.TasteNote ? "checked" : "";

                                <input type="radio" id="taste" name="TasteNote" value="@taste.Name" @isChecked/>
                                <label class="input-filter mb-15" for="taste">@taste.Name</label>
                                <br/>
                            }
                        </div>
                        <hr>
                        <h4 class="mb-10">Марки:</h4>
                        <div class="form-group">
                            @foreach (var brand in Model.Filters.Brands)
                            {
                                var isChecked = brand == Model.Filters.Brand ? "checked" : "";

                                <input type="radio" id="brand" name="brand" value="@brand" @isChecked/>
                                <label class="input-filter mb-15" for="brand">@brand</label>
                                <br/>
                            }
                        </div>
                        <hr>
                        <div class="form-group" style="display: flex; justify-content: space-around">
                            <div class="row flex-column">
                                <label for="minPrice">Мин. Цена</label>
                                <input type="number" value="@Model.Filters.MinPrice" name="minPrice" id="minPrice" asp-for="@Model.Filters.MinPrice">
                            </div>
                            <div class="row flex-column">
                                <label for="maxPrice">Макс. Цена</label>
                                <input type="number" value="@Model.Filters.MaxPrice" name="maxPrice" id="maxPrice" asp-for="@Model.Filters.MaxPrice">
                            </div>
                        </div>
                        <button type="submit" class="btn-filter w-100">Филтрирай</button>
                    </form>
                </div>
                <div class="col-lg-9 col-md-6 col-12 mb-60 pl-5">
                    <div class="row">
                        <form method="get" asp-action="All">
                            <span style="font-size: 15px;" class=" ml-2 mr-2">Сортирай по цена:</span>
                            <select style="border: 1px solid #d3d3d3; font-size: 15px;" name="sortOrder" id="sortOrder">
                                @if (@Model.sortedBy == "desc")
                                {
                                    <option value="desc">От висока към ниска</option>
                                    <option value="asc">От ниска към висока</option>
                                }
                                else
                                {
                                    <option value="asc">От ниска към висока</option>
                                    <option value="desc">От висока към ниска</option>
                                }
                            </select>

                            <button class="btn beige-button ml-4" type="submit">Сортирай</button>
                        </form>
                    </div>
                    <div class="row">
                        @foreach (var product in Model.Products)
                        {
                            <div class="col-lg-4 col-md-6 col-12 mb-60">
                                <div class="product">
                                    <div class="image">
                                        <a asp-action="Details" asp-route-id="@product.ProductId" class="img">
                                            <img style="height: 412px" src="~/Images/products/@product.ImageUrl" alt="Product">
                                        </a>
                                        @if ((DateTime.Now - product.CreatedOn).TotalDays < 14)
                                        {
                                            <span class="label">НОВО</span> 
                                        }
                                    </div>
                                    <div class="content">
                                        <div class="head fix">
                                            <div class="title-category float-left">
                                                <h5 class="title">
                                                    <a asp-action="Details" asp-route-id="@product.ProductId">@product.Name - @product.Weight.Value@product.Weight.Unit.</a>
                                                </h5>
                                                <a class="category">Кафе зърна</a>
                                            </div>
                                            <div class="price float-right">
                                                <span class="new">@product.Price лв.</span>
                                            </div>
                                        </div>
                                        <div class="action-button fix">
                                            @if (this.User.Identity.IsAuthenticated)
                                            {
                                                <a class="add-to-cart-all" asp-action="AddToCart" asp-route-productId="@product.ProductId">Добави в количката</a>
                                            }
                                            @if (this.User.IsInRole("Admin"))
                                            {
                                                <a class="edit-product-button" asp-action="Edit" asp-route-id="@product.ProductId">Редактирай</a>
                                                <a class="delete-product-button" asp-action="Delete" asp-route-id="@product.ProductId">Изтрий</a>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



